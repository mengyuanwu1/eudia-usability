rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function serverManaged(collection) {
      return collection in [
        'sourceEntries', 'events', 'actions', 'memories', 'workingStates',
        'interventionRuns', 'memoryState', 'memoryJobs',
        'challengeGenerations', 'coachingState', 'valueScores', 'valueWindows',
        'studyRuns'
      ];
    }

    match /users/{uid} {
      allow read, write: if owner(uid);

      // Preserve owner access to existing app data, including nested and
      // future raw collections, while keeping server projections read-only.
      match /{collection}/{document=**} {
        allow read: if owner(uid);
        allow write: if owner(uid) && !serverManaged(collection);
      }
    }
  }
}
